{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "allowImportingTsExtensions": true,
    "customConditions": [
      "react-native",
      "react-native-legacy-deep-imports"
    ],
    "paths": {
      "react-native-webview": [
        "./src/types/react-native-webview.d.ts"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx"
  ]
}
